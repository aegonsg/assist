# Copy to .env.local and replace all empty/example values. Never commit .env.local.
JWT_SECRET=
OWNER_USERNAME=
OWNER_PASSWORD_HASH=
OWNER_NAME=ADHAVAN
MONGODB_URI=
MONGODB_DB_NAME=personal_assistant
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_CONTACT_EMAIL=

# Set one server-only key name locally to enable Groq-backed answers.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
# Groq's quickstart uses GROQ_API_KEY; AI_API_KEY is also supported.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
